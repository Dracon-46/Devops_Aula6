{
  "name": "jokenpo-devops",
  "version": "1.0.0",
  "description": "Jokenpo jogavel no navegador com pipeline de CI/CD no GitHub Actions publicando no GitHub Pages",
  "type": "module",
  "private": true,
  "bin": {
    "analisar-pipeline": "src/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results/junit.xml",
    "lint": "eslint src tests scripts",
    "analisar": "node src/cli.js",
    "auto-analise": "node src/cli.js .github/workflows/pipeline.yml --formato=md",
    "build": "node scripts/build.mjs"
  },
  "keywords": [
    "devops",
    "github-actions",
    "ci-cd",
    "jokenpo",
    "jogo"
  ],
  "author": "Dracon-46",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "vitest": "^2.1.8"
  }
}
