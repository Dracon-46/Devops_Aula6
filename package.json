{
  "name": "analisador-de-pipelines",
  "version": "1.0.0",
  "description": "Analisador de workflows do GitHub Actions: extrai gatilhos, jobs e acoes e aplica regras de qualidade e seguranca",
  "type": "module",
  "private": true,
  "bin": {
    "analisar-pipeline": "src/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results/junit.xml",
    "lint": "eslint src tests",
    "analisar": "node src/cli.js",
    "auto-analise": "node src/cli.js .github/workflows/pipeline.yml --formato=md"
  },
  "keywords": [
    "devops",
    "github-actions",
    "ci-cd",
    "pipeline",
    "analise-estatica"
  ],
  "author": "Dracon-46",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "vitest": "^2.1.8"
  }
}
